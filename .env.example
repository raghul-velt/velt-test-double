# Meridian Outfitters test property: environment variables
#
# Copy to .env.local for local development. Nothing here is a real secret, and no
# value in this file is ever printed by the site: /harness reports presence only.

# Which copy the site serves.
#   clean  brand compliant copy, no planted violations
#   buggy  the 17 planted Meridian guideline violations
# Unset means buggy. Read on the server only, never exposed to the browser.
# Every page is statically generated, so a change needs a rebuild or a redeploy.
SITE_MODE=buggy

# Superflow toolbar embed. Both are required before the script tag is rendered at
# all: if either is missing the layout renders no toolbar and /harness says which
# one is absent. Take the values from the Superflow portal project settings.
NEXT_PUBLIC_SUPERFLOW_API_KEY=
NEXT_PUBLIC_SUPERFLOW_PROJECT_ID=
